# 学径 LearnPath 环境变量示例（复制为 .env）

# LLM：true=强制 Mock（演示无 Key）；false=按下方 Key 路由真实模型
LLM_MOCK=false

# Kimi / Moonshot（配置后优先于星火与辅助通道，主/辅任务均走 Kimi）
# 控制台：https://platform.moonshot.cn/
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-32k

# 讯飞星火（OpenAI 兼容对话）— 未配置 Kimi 时可用
SPARK_API_KEY=
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1
SPARK_MODEL=generalv3.5

# 讯飞星火 · 文生图 TTI（https://console.xfyun.cn/services/tti 申请，与上方 APIPassword 不同）
# 配置后将用于多模态讲解的 AI 配图；Kimi 负责优化提示词
# 注意：TTI 的 APIKey 与 OpenAI 兼容接口的 APIPassword 通常不是同一个值
SPARK_APP_ID=
SPARK_TTI_API_KEY=
SPARK_API_SECRET=
SPARK_TTI_MAX_IMAGES=4

# 阿里云百炼 · 千问 / 通义万相（多模态文生图，配置后优先于星火 TTI）
# 控制台：https://bailian.console.aliyun.com/
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_IMAGE_MODEL=qwen-image-2.0-pro
QWEN_IMAGE_MAX_IMAGES=4
QWEN_VL_MODEL=qwen-vl-plus

# 通义万相 · 图生/文生视频（POST .../video-generation/video-synthesis）
QWEN_VIDEO_ENABLED=true
QWEN_VIDEO_MODEL=wan2.6-i2v-flash
QWEN_VIDEO_T2V_MODEL=wan2.6-t2v
QWEN_VIDEO_DURATION=5
QWEN_VIDEO_RESOLUTION=720P
QWEN_VIDEO_T2V_SIZE=1280*720
QWEN_VIDEO_TIMEOUT_SEC=300

# 辅助云端 LLM（OpenAI 兼容，未配置 Kimi/星火 时主任务可走此通道）
AUX_LLM_API_KEY=
AUX_LLM_BASE_URL=https://api.siliconflow.cn/v1
AUX_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 数据库与向量库
DATABASE_URL=sqlite:///./storage/learnpath.db
CHROMA_PERSIST_DIR=./storage/chroma
KNOWLEDGE_BASE_DIR=./data/knowledge_base/ml_intro

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001

# JWT（生产环境务必修改 JWT_SECRET）
JWT_SECRET=learnpath-dev-secret-change-in-production
JWT_EXPIRE_HOURS=72
AUTO_PATH_AFTER_GENERATE=true

# 开发：start.ps1 在 DEV_RELOAD=true 时为 uvicorn 加 --reload
DEV_RELOAD=true

# 讯飞 TTS（可选；无配置时 /api/tts/speak 返回 mock，前端回退浏览器朗读）
SPARK_TTS_URL=

# 前端：留空则走 Next 开发代理（推荐）；生产部署时填完整 API 地址
# NEXT_PUBLIC_API_BASE=
